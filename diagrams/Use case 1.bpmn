    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_019" name="No" sourceRef="in_season" targetRef="merge_unavailable" />
    <bpmn:sequenceFlow id="Flow_020" name="Yes" sourceRef="stock_positive" targetRef="set_available">
