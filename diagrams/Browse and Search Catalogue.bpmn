<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_Catalogue" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="19abde7" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:error id="Error_Unavailable" name="Catalogue unavailable" errorCode="CATALOGUE_UNAVAILABLE" />
  <bpmn:collaboration id="Collaboration_Catalogue">
    <bpmn:participant id="Participant_Service" name="Browse and Search Catalogue Service" processRef="Process_BrowseSearchCatalogue" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BrowseSearchCatalogue" name="Browse and Search Catalogue" isExecutable="true">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Customer" name="Customer">
        <bpmn:flowNodeRef>Task_ShowError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NoResults</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_View</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Backend">
        <bpmn:flowNodeRef>Task_Sales</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Join2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FlagOOS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_Retrieve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Verified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Results</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:subProcess id="SubProcess_Retrieve" name="Retrieve catalogue data">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>Flow_1x3ku0e</bpmn:outgoing>
      <bpmn:property id="Property_1fqvof2" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_1xfb76a">
        <bpmn:sourceRef>DataStoreReference_1dwbe7f</bpmn:sourceRef>
        <bpmn:targetRef>Property_1fqvof2</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_0atedaf">
        <bpmn:targetRef>DataStoreReference_1dwbe7f</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:startEvent id="Start_Inner" name="Begin catalogue retrieval">
        <bpmn:outgoing>FI1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="GW_Mode" name="Browse or search?" default="Flow_Search">
        <bpmn:incoming>FI1</bpmn:incoming>
        <bpmn:outgoing>Flow_Browse</bpmn:outgoing>
        <bpmn:outgoing>Flow_Search</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Task_LoadCategory" name="Load category spreadsheet">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="load-category" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Browse</bpmn:incoming>
        <bpmn:outgoing>FI4</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_QueryKeywords" name="Query Product Key Words">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="query-product-keywords" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Search</bpmn:incoming>
        <bpmn:outgoing>FI5</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="GW_Merge">
        <bpmn:incoming>FI4</bpmn:incoming>
        <bpmn:incoming>FI5</bpmn:incoming>
        <bpmn:outgoing>FI6</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Task_Retrieve" name="Retrieve product details by Product ID">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="retrieve-product-details" />
        </bpmn:extensionElements>
        <bpmn:incoming>FI6</bpmn:incoming>
        <bpmn:outgoing>FI7</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_Inner" name="Catalogue retrieved">
        <bpmn:incoming>FI7</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="FI1" sourceRef="Start_Inner" targetRef="GW_Mode" />
      <bpmn:sequenceFlow id="Flow_Browse" name="Browse" sourceRef="GW_Mode" targetRef="Task_LoadCategory">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= mode = "browse"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_Search" name="Search" sourceRef="GW_Mode" targetRef="Task_QueryKeywords" />
      <bpmn:sequenceFlow id="FI4" sourceRef="Task_LoadCategory" targetRef="GW_Merge" />
      <bpmn:sequenceFlow id="FI5" sourceRef="Task_QueryKeywords" targetRef="GW_Merge" />
      <bpmn:sequenceFlow id="FI6" sourceRef="GW_Merge" targetRef="Task_Retrieve" />
      <bpmn:sequenceFlow id="FI7" sourceRef="Task_Retrieve" targetRef="End_Inner" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Boundary_Error" name="Catalogue unavailable" attachedToRef="SubProcess_Retrieve">
      <bpmn:outgoing>F21</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_1" errorRef="Error_Unavailable" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_Open" targetRef="Task_Choose" />
    <bpmn:sequenceFlow id="F19" sourceRef="Task_NoResults" targetRef="Task_Choose" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_Choose" targetRef="SubProcess_Retrieve" />
    <bpmn:sequenceFlow id="F20" sourceRef="Task_View" targetRef="End_Success" />
    <bpmn:sequenceFlow id="F21" sourceRef="Boundary_Error" targetRef="Task_ShowError" />
    <bpmn:sequenceFlow id="F22" sourceRef="Task_ShowError" targetRef="End_Failed" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Sales" targetRef="Task_Stock" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Stock" targetRef="GW_Stock" />
    <bpmn:sequenceFlow id="Flow_InStock" name="Yes" sourceRef="GW_Stock" targetRef="GW_Join2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= inStock = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NoStock" name="No" sourceRef="GW_Stock" targetRef="Task_FlagOOS" />
    <bpmn:sequenceFlow id="F14" sourceRef="Task_FlagOOS" targetRef="GW_Join2" />
    <bpmn:serviceTask id="Task_Sales" name="Apply Product Sales rules">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="apply-product-sales-rules" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1hwj6ll</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:property id="Property_1urogms" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_1tqedit">
        <bpmn:sourceRef>DataStoreReference_1dwbe7f</bpmn:sourceRef>
        <bpmn:targetRef>Property_1urogms</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_195rmsn">
        <bpmn:targetRef>DataStoreReference_1dwbe7f</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Stock" name="Calculate stock (Available minus Reserve)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-stock" />
      </bpmn:extensionElements>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:property id="Property_0m350vl" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_0uilzgc">
        <bpmn:sourceRef>DataStoreReference_1dwbe7f</bpmn:sourceRef>
        <bpmn:targetRef>Property_0m350vl</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1klg8q4">
        <bpmn:targetRef>DataStoreReference_1dwbe7f</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_Stock" name="Stock available?" default="Flow_NoStock">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>Flow_InStock</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoStock</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_Join2">
      <bpmn:incoming>Flow_InStock</bpmn:incoming>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>Flow_0wx6ton</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_FlagOOS" name="Flag product as out of stock">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="flag-out-of-stock" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NoStock</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_ShowError" name="View temporary error message">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="catalogue-error-form" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_NoResults" name="Review no results and refine search">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="catalogue-no-results-form" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0v5ruco</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Choose" name="Choose category or enter search term">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="catalogue-search-form" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Failed" name="Search failed">
      <bpmn:incoming>F22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Start_Open" name="Customer opens catalogue">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="End_Success" name="Results displayed">
      <bpmn:incoming>F20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DataStoreReference_1dwbe7f" name="Product Catalogue" />
    <bpmn:userTask id="Task_View" name="View results">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="catalogue-results-form" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1ozqrdl</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0v5ruco" name="No" sourceRef="GW_Results" targetRef="Task_NoResults" />
    <bpmn:exclusiveGateway id="GW_Verified" name="Data verified?" default="Flow_0bkjntf">
      <bpmn:incoming>Flow_1x3ku0e</bpmn:incoming>
      <bpmn:outgoing>Flow_1hwj6ll</bpmn:outgoing>
      <bpmn:outgoing>Flow_0bkjntf</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1x3ku0e" sourceRef="SubProcess_Retrieve" targetRef="GW_Verified" />
    <bpmn:sequenceFlow id="Flow_1hwj6ll" name="no" sourceRef="GW_Verified" targetRef="Task_Sales">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= dataVerified = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0wx6ton" sourceRef="GW_Join2" targetRef="GW_Results" />
    <bpmn:sequenceFlow id="Flow_1ozqrdl" name="Yes" sourceRef="GW_Results" targetRef="Task_View">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= resultsFound</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="GW_Results" name="Results found?" default="Flow_0v5ruco">
      <bpmn:incoming>Flow_0wx6ton</bpmn:incoming>
      <bpmn:incoming>Flow_0bkjntf</bpmn:incoming>
      <bpmn:outgoing>Flow_0v5ruco</bpmn:outgoing>
      <bpmn:outgoing>Flow_1ozqrdl</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0bkjntf" name="yes" sourceRef="GW_Verified" targetRef="GW_Results" />
  </bpmn:process>
